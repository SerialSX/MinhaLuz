; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Minha Luz"
config/description="Jogo 2D educativo sobre pensamentos negativos e positivos."
config/version="0.7"
run/main_scene="res://cenas/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.039, 0.078, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Jogo="*res://scripts/jogo.gd"
Audio="*res://scripts/audio.gd"
Placar="*res://scripts/placar.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://ui/tema.tres"

